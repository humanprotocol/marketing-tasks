# General
HOST=0.0.0.0
PORT=5007
SOCIAL_MEDIA_VALIDATION_MAX_RETRIES=5

# Postgres
POSTGRES_URL=postgresql://user:password@host:5432/recording-oracle
POSTGRES_SSL=true
POSTGRES_LOGGING=log,info,warn,error

# S3
S3_ENDPOINT=s3.example.com
S3_PORT=443
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_BUCKET=marketing
S3_USE_SSL=true

# Web3
WEB3_PRIVATE_KEY=replace_me
RPC_URL_POLYGON_AMOY=https://rpc-amoy.polygon.technology

# Grok
GROK_API_KEY=replace_me
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-reasoning

# X API
X_CONSUMER_KEY=replace_me
X_CONSUMER_SECRET=replace_me
X_ACCESS_TOKEN=replace_me
X_ACCESS_TOKEN_SECRET=replace_me
X_API_BASE_URL=https://api.x.com/2
X_API_PAGE_SIZE=100
X_API_MAX_PAGES_PER_ACTION=10

# LinkdAPI
LINKDAPI_API_KEY=replace_me
LINKDAPI_BASE_URL=https://linkdapi.com
LINKDAPI_PAGE_SIZE=100
LINKDAPI_MAX_PAGES_PER_ACTION=10

# Encryption
PGP_ENCRYPT=false
